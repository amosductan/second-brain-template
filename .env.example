# Copy to .env and fill in. Everything is optional; the app degrades gracefully:
#   no model provider -> notes are stored and searchable, not filed; chat is off
#   no transcription  -> audio is stored; hit "Retry processing" after adding a key

# ---- model provider (the categorizer and chat) --------------------------------
# anthropic | openai | gemini | ollama. Blank picks from whichever key is set,
# in that order. Naming one means only that one is ever used.
LLM_PROVIDER=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Models. Blank uses the provider's default:
#   anthropic: claude-opus-5    (claude-sonnet-5 costs less, claude-haiku-4-5 less again)
#   openai:    gpt-5.4-mini
#   gemini:    gemini-3.5-flash
#   ollama:    llama3.1         (any model you've pulled that supports tools)
CATEGORIZER_MODEL=
CHAT_MODEL=

# For openai/gemini/ollama: override the endpoint to use any server that speaks
# OpenAI's chat-completions API (LM Studio, vLLM, OpenRouter, a proxy).
LLM_BASE_URL=

# Anthropic models are priced automatically in the usage ledger. For any other
# model, set its USD price per million tokens to have costs estimated too.
LLM_PRICE_IN=
LLM_PRICE_OUT=

# ---- transcription ---------------------------------------------------------------
# Any server with OpenAI's /audio/transcriptions endpoint: OpenAI (default),
# Groq, or a local Whisper server. The key defaults to OPENAI_API_KEY.
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_PRICE_PER_MIN=0.006

# ---- server -----------------------------------------------------------------------
PORT=3000
# 127.0.0.1 keeps it on this machine. Use 0.0.0.0 to reach it from other devices
# (Docker sets this for you), and set AUTH_TOKEN before you do.
HOST=127.0.0.1

# If set, every /api request must send "Authorization: Bearer <token>".
AUTH_TOKEN=

# Where the database and audio live (default: ./data, which git ignores).
# Keep it out of a synced folder (Dropbox, OneDrive, iCloud): syncing a live
# SQLite database can corrupt it. Snapshots are fine to sync; see below.
DATA_DIR=

# Optional second copy of each nightly snapshot (npm run backup).
BACKUP_OFFSITE_DIR=

# Audio older than this is deleted by scripts/prune_audio.mjs; transcripts are kept.
AUDIO_RETENTION_DAYS=180
